# Reddit (public JSON — no auth required)
REDDIT_USER_AGENT=trick-or-treat/1.0 (personal project)
REDDIT_SUBREDDITS=programming,webdev,devops

# Dev.to
DEVTO_API_KEY=your_devto_api_key_here

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Meta Threads
THREADS_APP_ID=your_threads_app_id_here
THREADS_APP_SECRET=your_threads_app_secret_here
THREADS_ACCESS_TOKEN=your_threads_access_token_here
THREADS_USER_ID=your_threads_user_id_here

# Scraper settings
SCRAPE_LIMIT=1

# Posting limits
DAILY_POST_LIMIT=3
POST_DELAY_MIN=30
POST_DELAY_MAX=120
